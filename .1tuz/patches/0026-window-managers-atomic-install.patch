index 0000000000000000000000000000000000000000..2e759d883316a3f3944af5f115c377ed42cb67e7
--- /dev/null
+++ b/Tests/ext-install-transaction-test.swift
@@ -0,0 +1,63 @@
+import Foundation
+
+@main
+@MainActor
+struct ExtensionInstallTransactionTests {
+    static func main() throws {
+        let fm = FileManager.default
+        let temp = fm.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try fm.createDirectory(at: temp, withIntermediateDirectories: false)
+        defer { try? fm.removeItem(at: temp) }
+        let source = temp.appendingPathComponent("source")
+        let root = temp.appendingPathComponent("installed")
+        try fm.createDirectory(at: source, withIntermediateDirectories: false)
+        let manifest = source.appendingPathComponent("package.json")
+        let js = source.appendingPathComponent("run.js")
+        func prepare(_ name: String = "test-package", _ body: String, commands: String = "", contract: String = "") throws {
+            let content = """
+            {"name":"\(name)","commands":[{"name":"run","title":"Run","mode":"no-view"}\(commands)]\(contract)}
+            """
+            try Data(content.utf8).write(to: manifest)
+            try Data(body.utf8).write(to: js)
+        }
+        func expectFailure(_ operation: () throws -> Void) {
+            do { try operation() } catch { return }
+            fatalError("Expected installation failure")
+        }
+        try prepare("test-package", "first")
+        let installed = try ExtensionCatalog.install(from: source, in: root)
+        let installedJS = installed.directory.appendingPathComponent("run.js")
+        func verify(_ expected: String) throws {
+            let actual = try String(contentsOf: installedJS, encoding: .utf8)
+            precondition(actual == expected, "Installed extension changed unexpectedly")
+        }
+        try verify("first")
+        try prepare("test-package", "second")
+        _ = try ExtensionCatalog.install(from: source, in: root)
+        try verify("second")
+        try prepare("test-package", "bad", contract: ",\"speechcast\":{\"schemaVersion\":999}")
+        expectFailure { _ = try ExtensionCatalog.install(from: source, in: root) }
+        try verify("second")
+        try prepare(
+            "test-package", "bad",
+            commands: ", {\"name\":\"missing\",\"title\":\"Missing\",\"mode\":\"no-view\"}",
+            contract: ",\"speechcast\":{\"schemaVersion\":1,\"apiVersion\":1}")
+        expectFailure { _ = try ExtensionCatalog.install(from: source, in: root) }
+        try verify("second")
+        try prepare("test-package", "bad")
+        try fm.removeItem(at: js)
+        try fm.createSymbolicLink(at: js, withDestinationURL: installedJS)
+        expectFailure { _ = try ExtensionCatalog.install(from: source, in: root) }
+        try verify("second")
+        try fm.removeItem(at: js)
+        try prepare("test/package", "collision")
+        expectFailure { _ = try ExtensionCatalog.install(from: source, in: root) }
+        try verify("second")
+        try prepare("../escape", "bad")
+        expectFailure { _ = try ExtensionCatalog.install(from: source, in: root) }
+        try verify("second")
+        let dirs = try fm.contentsOfDirectory(atPath: root.path)
+        precondition(dirs == ["test-package"], "Unexpected staging residue: \(dirs)")
+        print("Extension install transaction: passed")
+    }
+}
diff --git a/Tests/shared-window-manager-test.swift b/Tests/shared-window-manager-test.swift
new file mode 100644
index 0000000000000000000000000000000000000000..fba1904754e4d259929de3fbd34cca9439e6a087
--- /dev/null
+++ b/Tests/shared-window-manager-test.swift
@@ -0,0 +1,80 @@
+import Foundation
+
+@main
+struct SharedWindowManagerTests {
+    static func main() {
+        typealias Policy = SharedWindowManagerPolicy
+        typealias Backend = SharedWindowManagerBackend
+        func check(_ condition: @autoclosure () -> Bool, _ message: String) {
+            guard condition() else { fatalError(message) }
+        }
+        check(
+            Policy.choose(.native, stableBarSource: "rift", running: [.rift]) == .native,
+            "explicit native")
+        check(
+            Policy.choose(.automatic, stableBarSource: nil, running: []) == .native,
+            "no manager")
+        for backend in Backend.allCases {
+            check(
+                Policy.choose(.automatic, stableBarSource: nil, running: [backend]) == .external(backend),
+                "automatic detection")
+            check(
+                Policy.choose(.automatic, stableBarSource: "spaces", running: [backend]) == .external(backend),
+                "Spaces does not override tiler")
+            check(
+                Policy.choose(
+                    .automatic, stableBarSource: backend.rawValue, running: Set(Backend.allCases))
+                    == .external(backend),
+                "StableBar choice")
+            check(
+                Policy.choose(
+                    SharedWindowManagerSelection(rawValue: backend.rawValue)!,
+                    stableBarSource: nil, running: []) == .external(backend),
+                "explicit selection does not fall back")
+            check(
+                Policy.command(.leftHalf, for: backend) == nil,
+                "no arbitrary frame writes to tiled windows")
+            check(Policy.command(.closeWindow, for: backend) != nil, "close mapping")
+            check(
+                Policy.workspace(1, moveWindow: true, backend: backend)
+                    != Policy.workspace(1, moveWindow: false, backend: backend),
+                "switch versus move")
+        }
+        if case .unavailable = Policy.choose(.automatic, stableBarSource: nil, running: [.rift, .yabai]) {
+        } else {
+            fatalError("ambiguous managers")
+        }
+        if case .unavailable = Policy.choose(.automatic, stableBarSource: "unknown", running: []) {
+        } else {
+            fatalError("unknown source")
+        }
+        check(
+            Policy.workspace(1, moveWindow: false, backend: .rift)
+                == ["execute", "workspace", "switch", "0"],
+            "Rift zero-based switch")
+        check(
+            Policy.workspace(20, moveWindow: true, backend: .rift)
+                == ["execute", "workspace", "move-window", "19"],
+            "Rift zero-based move")
+        check(
+            Policy.command(.moveLeft, for: .rift) == ["execute", "layout", "move-node", "left"],
+            "Rift move")
+        check(
+            Policy.command(.moveRight, for: .omniwm) == ["command", "move", "right"],
+            "OmniWM move")
+        check(Policy.command(.moveUp, for: .kiwidesk) == ["swap", "up"], "KiwiDesk swap")
+        check(
+            Policy.workspace(2, moveWindow: true, backend: .aerospace)
+                == ["move-node-to-workspace", "--", "2"],
+            "AeroSpace legacy mapping")
+        check(
+            Policy.workspace(2, moveWindow: false, backend: .yabai)
+                == ["-m", "space", "--focus", "2"],
+            "yabai legacy mapping")
+        check(Backend.rift.cliName == "rift-cli" && Backend.omniwm.cliName == "omniwmctl", "actual executable names")
+        check(
+            Backend.aerospace.permitsNativeFloatingGeometry && !Backend.rift.permitsNativeFloatingGeometry,
+            "floating policy")
+        print("Shared window manager policy: passed")
+    }
+}
