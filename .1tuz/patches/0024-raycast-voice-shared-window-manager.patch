diff --git a/docs/features/speechcast-shared-window-manager.md b/docs/features/speechcast-shared-window-manager.md
new file mode 100644
--- /dev/null
+++ b/docs/features/speechcast-shared-window-manager.md
@@ -0,0 +1,46 @@
+# SpeechCast: Raycast voice actions and a shared window manager
+
+## Voice actions
+
+Enable Extensions and local voice commands in Settings. Installed, visible Raycast
+commands appear in the searchable voice catalog, where they can be assigned aliases.
+
+- `Запусти расширение Find Issue` resolves the extension command by name.
+- `Запусти расширение Find Issue с текстом DEV-123` passes `DEV-123` to the one declared text argument.
+- Assign the alias `найди задачу` to that command to say `найди задачу DEV-123`.
+
+All spoken extension launches require confirmation because JavaScript view commands
+may still perform side effects. If a command declares multiple, non-text or required
+arguments that were not supplied, SpeechCast does not guess them or run it silently.
+It offers the normal launcher form for required arguments.
+
+## Sharing window management with StableBar
+
+Select **Settings > Window Management > Window manager**:
+
+- **Automatic (StableBar)** reads `workspaceSource` from
+  `~/.config/stablebar/config.json` when present, then falls back to a running
+  AeroSpace or yabai. The config may use includes/layers; in that case explicitly
+  choose the provider if automatic detection does not match your active widget.
+- **AeroSpace** or **yabai** requires the existing manager process and its CLI
+  installed on PATH or in `/opt/homebrew/bin` or `/usr/local/bin`.
+- **SpeechCast (Accessibility)** keeps the original independent window controls.
+
+When a shared tiler is active, window movement, monitor/workspace changes, close,
+minimize and fullscreen commands go through the manager CLI. Native pixel sizing
+is limited to *floating* windows. For tiled windows, unsupported half/third/preset
+geometry is rejected instead of fighting the manager's layout. Saved pixel layouts,
+rooms and auto-layout-on-app-launch are likewise suspended until native mode is
+selected. StableBar remains the presenter of workspaces; no second tiler or daemon
+is installed.
+
+Voice examples (requires AeroSpace/yabai and existing destination workspace):
+
+- `Отправь окно на рабочий стол 3`
+- `Переключись на рабочий стол 3`
+
+The workspace commands accept numeric IDs 1 through 20. yabai uses Mission Control
+space indices; AeroSpace uses workspace names `1`, `2`, ... instead. Unsupported
+providers (OmniWM, Rift) are not rewritten to an unrelated backend.
+
+Source changes stay in `.1tuz/patches/0024-raycast-voice-shared-window-manager.patch`.
diff --git a/Tinycast/Features/WindowManagement/UI/WindowCommandCoordinator.swift b/Tinycast/Features/WindowManagement/UI/WindowCommandCoordinator.swift
--- a/Tinycast/Features/WindowManagement/UI/WindowCommandCoordinator.swift
+++ b/Tinycast/Features/WindowManagement/UI/WindowCommandCoordinator.swift
@@ -1,50 +1,362 @@
 import AppKit
+import Darwin
 
-/// The one funnel from a palette row or a global hotkey to the mover.
+/// Select the same window-manager process that StableBar uses, not a second tiler.
+enum SharedWindowManagerSelection: String, CaseIterable, Identifiable {
+    case automatic, native, aerospace, yabai
+
+    static let defaultsKey = "speechcast.windowManager.provider"
+    var id: String { rawValue }
+    var title: String {
+        switch self {
+        case .automatic: "Automatic (StableBar)"
+        case .native: "SpeechCast (Accessibility)"
+        case .aerospace: "AeroSpace"
+        case .yabai: "yabai"
+        }
+    }
+}
+
+/// Small, allowlisted CLI adapter. StableBar continues to own only its UI; both
+/// apps talk to the *same running* AeroSpace/yabai process and its workspaces.
+@MainActor
+enum SharedWindowManagerBridge {
+    enum Backend: String { case aerospace, yabai }
+    enum Resolution {
+        case native
+        case external(Backend, executable: String)
+        case unavailable(String)
+    }
+
+    static func resolve() -> Resolution {
+        let selected = SharedWindowManagerSelection(
+            rawValue: UserDefaults.standard.string(forKey: SharedWindowManagerSelection.defaultsKey) ?? "automatic"
+        ) ?? .automatic
+        switch selected {
+        case .native: return .native
+        case .aerospace: return resolve(.aerospace)
+        case .yabai: return resolve(.yabai)
+        case .automatic:
+            // StableBar's explicit workspaceSource takes precedence over an incidental
+            // background window manager. Its other sources are not emulated here.
+            if let configured = stableBarSource() {
+                switch configured {
+                case "aerospace": return resolve(.aerospace)
+                case "yabai": return resolve(.yabai)
+                case "spaces": return .native
+                default: return .unavailable("StableBar uses \(configured). Select a compatible manager or native mode.")
+                }
+            }
+            if isRunning(.aerospace) { return resolve(.aerospace) }
+            if isRunning(.yabai) { return resolve(.yabai) }
+            return .native
+        }
+    }
+
+    private static func resolve(_ backend: Backend) -> Resolution {
+        guard isRunning(backend) else {
+            return .unavailable("\(backend.rawValue) is not running. Window geometry was not changed.")
+        }
+        guard let executable = executable(for: backend) else {
+            return .unavailable("\(backend.rawValue) CLI was not found. Check your PATH or Homebrew installation.")
+        }
+        return .external(backend, executable: executable)
+    }
+
+    private static func stableBarSource() -> String? {
+        let file = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".config/stablebar/config.json")
+        guard let data = try? Data(contentsOf: file),
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+        else { return nil }
+        return object["workspaceSource"] as? String
+    }
+
+    private static func isRunning(_ backend: Backend) -> Bool {
+        switch backend {
+        case .aerospace:
+            return !NSRunningApplication.runningApplications(withBundleIdentifier: "bobko.aerospace").isEmpty
+        case .yabai:
+            let capacity = proc_listallpids(nil, 0)
+            guard capacity > 0 else { return false }
+            var pids = [pid_t](repeating: 0, count: Int(capacity) + 64)
+            let count = pids.withUnsafeMutableBytes { proc_listallpids($0.baseAddress, Int32($0.count)) }
+            let user = getuid()
+            let size = Int32(MemoryLayout<proc_bsdshortinfo>.size)
+            return pids.prefix(Int(max(count, 0))).contains { pid in
+                var info = proc_bsdshortinfo()
+                guard pid > 0,
+                      proc_pidinfo(pid, PROC_PIDT_SHORTBSDINFO, 0, &info, size) == size,
+                      info.pbsi_uid == user else { return false }
+                return withUnsafeBytes(of: info.pbsi_comm) {
+                    String(decoding: $0.prefix { $0 != 0 }, as: UTF8.self)
+                } == "yabai"
+            }
+        }
+    }
+
+    private static func executable(for backend: Backend) -> String? {
+        let name = backend.rawValue
+        let path = (ProcessInfo.processInfo.environment["PATH"] ?? "")
+            .split(separator: ":").map(String.init)
+        let dirs = path + ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin"]
+        for directory in dirs {
+            let candidate = URL(fileURLWithPath: directory).appendingPathComponent(name).path
+            if FileManager.default.isExecutableFile(atPath: candidate) { return candidate }
+        }
+        return nil
+    }
+
+    /// Only commands that a tiler owns. In particular, arbitrary half/third
+    /// placements are NOT sent through AX for tiled windows behind its back.
+    static func command(_ id: WindowCommand.ID, for backend: Backend) -> [String]? {
+        switch backend {
+        case .aerospace:
+            switch id {
+            case .previousSpace: return ["workspace", "prev"]
+            case .nextSpace: return ["workspace", "next"]
+            case .nextDisplay: return ["move-node-to-monitor", "next"]
+            case .previousDisplay: return ["move-node-to-monitor", "prev"]
+            case .moveLeft: return ["move", "left"]
+            case .moveRight: return ["move", "right"]
+            case .moveUp: return ["move", "up"]
+            case .moveDown: return ["move", "down"]
+            case .makeLarger: return ["resize", "smart", "+50"]
